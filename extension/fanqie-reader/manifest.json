{
  "manifest_version": 3,
  "name": "ChatNoGPT 阅读桥接",
  "version": "0.2.1",
  "description": "把已登录的来源网站章节显示在 ChatNoGPT 阅读面板中。",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://fanqienovel.com/*",
    "https://www.jjwxc.net/*",
    "https://jjwxc.net/*",
    "https://chatnogpt.autowired.cn/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://fanqienovel.com/*"],
      "js": ["fanqie.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.jjwxc.net/*", "https://jjwxc.net/*"],
      "js": ["jinjiang.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*", "https://chatnogpt.autowired.cn/*"],
      "js": ["chat.js"],
      "run_at": "document_idle"
    }
  ]
}
