<+>* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { height: 100%; }\nbody {\n  font-family: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", \"Microsoft YaHei\", \"PingFang SC\", sans-serif;\n  font-size: 16px;\n  color: #ececec;\n  background: #1e1e1e;\n  overflow: hidden;\n}\n.hidden { display: none !important; }\nbutton { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }\ninput, textarea { font: inherit; color: inherit; }\n\n/* ---------- auth ---------- */\n.auth-view {\n  position: fixed; inset: 0; z-index: 10;\n  display: flex; align-items: center; justify-content: center;\n  background: radial-gradient(1100px 600px at 50% -10%, #2a2a35 0%, #0d0d0d 60%);\n}\n.auth-card {\n  width: 380px; max-width: calc(100vw - 32px);\n  background: #2f2f2f; border: 1px solid rgba(255,255,255,.06);\n  border-radius: 18px; padding: 34px 30px 30px;\n  box-shadow: 0 20px 60px rgba(0,0,0,.5);\n}\n.auth-logo { font-size: 26px; font-weight: 700; text-align: center; letter-spacing: -.5px; color: #fff; }\n.auth-sub { font-size: 13px; color: #9b9b9b; text-align: center; margin: 6px 0 22px; }\n.auth-tabs { display: flex; background: #262626; border-radius: 10px; padding: 4px; margin-bottom: 18px; }\n.auth-tabs button { flex: 1; padding: 8px 0; border-radius: 8px; font-size: 14px; color: #9b9b9b; }\n.auth-tabs button.active { background: #1e1e1e; color: #fff; font-weight: 600; }\n.auth-card input {\n  width: 100%; background: #262626; border: 1px solid #3f3f3f; border-radius: 10px;\n  padding: 11px 13px; outline: none; margin-bottom: 12px; font-size: 14px; color: #ececec;\n}\n.auth-card input::placeholder { color: #8e8e8e; }\n.auth-card input:focus { border-color: #6b6b6b; }\n.form-error { color: #ff6b6b; font-size: 13px; min-height: 18px; margin: -4px 0 8px; }\n.btn-primary { width: 100%; background: #fff; color: #0d0d0d; border-radius: 10px; padding: 12px 0; font-weight: 600; }\n.btn-primary:hover { background: #e3e3e3; }\n.name-row { display: flex; gap: 8px; margin-bottom: 12px; }\n.name-row input { flex: 1; margin-bottom: 0; }\n.name-row button {\n  flex: none; width: 42px;\n  border: 1px solid #3f3f3f; border-radius: 10px;\n  font-size: 16px; color: #b4b4b4;\n}\n.name-row button:hover { background: rgba(255,255,255,.06); }\n\n/* ---------- layout ---------- */\n.app { display: flex; height: 100vh; height: 100dvh; }\n\n/* sidebar */\n#sidebar {\n  width: 260px; flex: none;\n  background: #171717; color: #e3e3e3;\n  display: flex; flex-direction: column; padding: 12px 10px;\n}\n.brand { font-weight: 700; font-size: 15px; padding: 6px 8px 14px; color: #fff; letter-spacing: -.3px; }\n.side-new { width: 100%; padding: 10px; border-radius: 10px; text-align: left; color: #ececec; font-size: 14px; border: 1px solid #414141; }\n.side-new:hover { background: #2b2b2b; }\n#convList { flex: 1; overflow-y: auto; margin-top: 6px; }\n.conv-item {\n  display: block; width: 100%; text-align: left;\n  padding: 10px; border-radius: 10px;\n  font-size: 14px; color: #dcdcdc;\n  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  margin-bottom: 2px;\n}\n.conv-item:hover { background: #262626; }\n.conv-item.active { background: #323232; }\n.conv-item { position: relative; padding-right: 48px; }\n.conv-unread {\n  position: absolute; right: 10px; top: 50%; transform: translateY(-50%);\n  min-width: 20px; height: 20px; padding: 0 5px;\n  border-radius: 999px; background: #ef4444; color: white;\n  display: inline-flex; align-items: center; justify-content: center;\n  font-size: 11px; font-weight: 700; line-height: 1;\n}\n.conv-empty { color: #8e8e8e; font-size: 13px; padding: 8px 10px; }\n.side-foot { border-top: 1px solid #2a2a2a; padding-top: 10px; }\n.user-chip { display: flex; align-items: center; gap: 10px; padding: 6px 8px; }\n.avatar {\n  width: 30px; height: 30px; border-radius: 50%;\n  background: #19c37d; color: #064e35;\n  font-size: 14px; font-weight: 700;\n  display: flex; align-items: center; justify-content: center; flex: none;\n}\n.uname { flex: 1; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n#btnLogout { color: #999; font-size: 13px; padding: 4px 8px; border-radius: 8px; }\n#btnLogout:hover { background: #2a2a2a; color: #fff; }\n.side-mask { display: none; }\n\n/* main */\n.chat-main { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #1e1e1e; }\n.chat-head {\n  display: flex; align-items: center; gap: 8px;\n  height: 52px; padding: 0 16px;\n  border-bottom: 1px solid #2f2f2f; flex: none;\n}\n.chat-title { flex: 1; font-size: 15px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.icon-btn { font-size: 18px; padding: 4px 8px; border-radius: 8px; color: #b4b4b4; }\n.icon-btn:hover { background: rgba(255,255,255,.08); }\n.mobile-only { display: none; }\n\n/* messages */\n.msg-scroll { flex: 1; overflow-y: auto; }\n.msg-col { max-width: 768px; margin: 0 auto; padding: 28px 20px 10px; }\n.time-divider {\n  text-align: center; font-size: 12px; color: #8e8e8e;\n  margin: 6px 0 16px; user-select: none; letter-spacing: .3px;\n}\n.welcome { text-align: center; padding-top: 18vh; }\n.welcome h1 { font-size: 30px; font-weight: 650; letter-spacing: -.5px; color: #ececec; }\n.welcome p { color: #9b9b9b; margin-top: 10px; font-size: 14px; }\n.msg-own { margin: 0 0 14px; }\n.msg-own > .real-wrap { display: flex; justify-content: flex-end; }\n.msg-own .bubble {\n  background: #2f2f2f; border-radius: 22px; padding: 10px 18px; max-width: 72%;\n  position: relative; white-space: pre-wrap; word-break: break-word; line-height: 1.65; font-size: 15.5px;\n}\n/* 原文始终参与排版，伪装文字只在原气泡内绘制，不改变其宽高。 */\n.msg-own .own-cover { display: none; }\nbody.cover-on .msg-own.covered:not(.reveal-active):not(.flash) .own-original { visibility: hidden; }\nbody.cover-on .msg-own.covered:not(.reveal-active):not(.flash) .own-cover {\n  display: block; position: absolute; inset: 10px 18px;\n  overflow: hidden; white-space: pre-wrap; word-break: break-word;\n}\n/* 图片消息隐藏原图和附带文字，气泡仅保留 [image]；主动悬停才展开。 */\n.msg-own .image-placeholder { display: none; }\nbody.cover-on .msg-own.has-image.covered:not(.reveal-active):not(.flash) .own-original,\nbody.cover-on .msg-own.has-image.covered:not(.reveal-active):not(.flash) .own-cover,\nbody.cover-on .msg-own.has-image.covered:not(.reveal-active):not(.flash) .chat-image { display: none; }\nbody.cover-on .msg-own.has-image.covered:not(.reveal-active):not(.flash) .image-placeholder { display: inline; }\n.msg-ai { margin: 0 0 26px; }\n.ai-label { font-size: 12.5px; font-weight: 600; color: #8e8e8e; margin-bottom: 3px; }\n.ai-body { white-space: pre-wrap; word-break: break-word; line-height: 1.75; font-size: 15.5px; }\n.msg-ai-time { font-size: 11px; color: #8e8e8e; margin: 0 0 4px; }\n.novel-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin: 0 0 22px; font-size: 13px; }\n.novel-controls a, .novel-controls button { color: #b7c9ff; text-decoration: underline; }\n.novel-hint { flex-basis: 100%; color: #999; font-size: 12px; }\n.novel-browser { width: 100%; min-height: 65vh; border: 1px solid #3a3a3a; border-radius: 14px; overflow: hidden; background: #242424; }\n.novel-browser-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 10px 14px; border-bottom: 1px solid #3a3a3a; background: #2b2b2b; }\n.novel-browser-title { flex: 1; min-width: 160px; font-size: 14px; }\n.novel-browser-toolbar button, .novel-browser-toolbar a { padding: 6px 9px; border-radius: 7px; background: #3b3b3b; color: #ececec; font-size: 12px; text-decoration: none; }\n.novel-browser-toolbar button:hover, .novel-browser-toolbar a:hover { background: #4a4a4a; }\n.novel-browser-status { padding: 8px 16px; color: #aaa; font-size: 12px; border-bottom: 1px solid #333; }\n.novel-browser-content { height: min(65vh, 750px); overflow-y: auto; padding: 26px max(20px, calc((100% - 760px) / 2)); white-space: pre-wrap; overflow-wrap: anywhere; font-size: 17px; line-height: 2; color: #e8e2d7; }\n.novel-browser { position: relative; }\n.novel-cover { position: absolute; inset: 0; z-index: 4; overflow-y: auto; padding: 28px max(24px, calc((100% - 760px) / 2)); background: #242424; color: #e8e8e8; opacity: 0; visibility: hidden; pointer-events: none; }\nbody.cover-on .novel-cover { opacity: 1; visibility: visible; pointer-events: auto; }\n.novel-cover-heading { font-size: 18px; font-weight: 650; margin-bottom: 18px; }\n.novel-cover-intro { color: #aaa; font-size: 14px; line-height: 1.8; margin-bottom: 30px; }\n.novel-cover-body p { font-size: 16px; line-height: 1.95; margin-bottom: 26px; }\nbody.cover-on .novel-browser[data-reveal-shape=\"circle\"][data-reveal-has-selection=\"1\"]:is([data-reveal-mode=\"setup\"], [data-reveal-mode=\"active\"]:hover) .novel-cover {\n  -webkit-mask-image: radial-gradient(circle calc(var(--novel-w, 300px) / 2) at var(--novel-fx, 50%) var(--novel-fy, 50%), transparent 0 calc(var(--novel-w, 300px) / 2 - 2px), #000 calc(var(--novel-w, 300px) / 2));\n  mask-image: radial-gradient(circle calc(var(--novel-w, 300px) / 2) at var(--novel-fx, 50%) var(--novel-fy, 50%), transparent 0 calc(var(--novel-w, 300px) / 2 - 2px), #000 calc(var(--novel-w, 300px) / 2));\n}\nbody.cover-on .novel-browser[data-reveal-shape=\"rect\"][data-reveal-has-selection=\"1\"]:is([data-reveal-mode=\"setup\"], [data-reveal-mode=\"active\"]:hover) .novel-cover {\n  -webkit-mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);\n  -webkit-mask-size: 100% 100%, var(--novel-w, 300px) var(--novel-h, 195px);\n  -webkit-mask-position: 0 0, var(--novel-left, 0px) var(--novel-top, 0px);\n  -webkit-mask-repeat: no-repeat;\n  -webkit-mask-composite: xor;\n  mask-image: linear-gradient(#000 0 0), linear-gradient(#000 0 0);\n  mask-size: 100% 100%, var(--novel-w, 300px) var(--novel-h, 195px);\n  mask-position: 0 0, var(--novel-left, 0px) var(--novel-top, 0px);\n  mask-repeat: no-repeat;\n  mask-composite: exclude;\n}\n.novel-reveal-outline { position: absolute; z-index: 5; pointer-events: none; left: var(--novel-left, 0px); top: var(--novel-top, 0px); width: var(--novel-w, 300px); height: var(--novel-h, 195px); border: 1px solid rgba(160,220,190,.65); box-shadow: 0 0 18px rgba(160,220,190,.18); opacity: 0; }\nbody.cover-on .novel-browser[data-reveal-has-selection=\"1\"]:is([data-reveal-mode=\"setup\"], [data-reveal-mode=\"active\"]:hover) .novel-reveal-outline { opacity: 1; }\n.novel-browser[data-reveal-shape=\"circle\"] .novel-reveal-outline { border-radius: 50%; }\n.novel-browser[data-reveal-shape=\"rect\"] .novel-reveal-outline { border-radius: 6px; }\n.novel-reveal-setup { display: none; position: absolute; z-index: 6; top: 12px; left: 50%; transform: translateX(-50%); max-width: calc(100% - 24px); padding: 8px 10px; border: 1px solid #5b5b5b; border-radius: 10px; background: #303030; box-shadow: 0 8px 26px rgba(0,0,0,.4); align-items: center; gap: 7px; white-space: nowrap; }\nbody.cover-on .novel-browser[data-reveal-mode=\"setup\"] .novel-reveal-setup { display: flex; }\n.novel-reveal-setup span { color: #ddd; font-size: 12px; margin-right: 4px; }\n.novel-reveal-setup button { padding: 5px 9px; border: 1px solid #666; border-radius: 7px; background: #3b3b3b; font-size: 12px; }\n.novel-reveal-setup button.active { background: #52695c; border-color: #8fbea1; }\n.novel-reveal-setup button:disabled { opacity: .45; cursor: default; }\n@media (max-width: 680px) { .novel-reveal-setup { flex-wrap: wrap; justify-content: center; white-space: normal; } }\n.chat-image { display: block; max-width: min(360px, 100%); max-height: 320px; border-radius: 12px; object-fit: contain; cursor: zoom-in; margin-top: 6px; }\n.bubble .chat-image { max-width: 100%; }\nbody.cover-on .msg-ai.covered .chat-image { cursor: default; }\n.image-preview {\n  display: flex; align-items: flex-end; gap: 12px;\n  min-height: 132px; padding: 4px 4px 12px;\n  font-size: 12px; color: #b7b7b7;\n}\n.image-preview img {\n  display: block; max-width: 160px; max-height: 120px;\n  border-radius: 10px; object-fit: contain;\n  background: #242424; border: 1px solid rgba(255,255,255,.1);\n}\n.image-preview button {\n  color: #ddd; padding: 5px 8px; border-radius: 8px;\n  background: #3b3b3b;\n}\n.image-preview button:hover { background: #4a4a4a; }\n.picker-overlay { position: fixed; inset: 0; z-index: 30; background: rgba(0,0,0,.7); display: flex; align-items: center; justify-content: center; padding: 16px; }\n.picker-panel { width: min(420px, 100%); max-height: 75vh; overflow-y: auto; background: #2f2f2f; border-radius: 16px; padding: 20px; }\n.picker-panel h2 { margin: 0 0 14px; font-size: 18px; }\n.picker-panel input { width: 100%; padding: 10px; background: #1e1e1e; color: #ececec; border: 1px solid #666; border-radius: 8px; }\n.picker-panel button { display: block; width: 100%; text-align: left; padding: 10px; border-radius: 8px; }\n.picker-panel button:hover { background: #444; }\n.picker-panel .cancel { margin-top: 8px; color: #aaa; }\n\n/* ---------- 思考伪装：覆盖层 + 圆形遮罩透视 ---------- */\n\n/* 两层同格排版，行高取最长的一层；关闭伪装时覆盖层不参与布局。 */\n.msg-real { display: grid; align-items: start; position: relative; --hole: 140px; }\n.msg-real > .real-wrap, .msg-real > .cover-layer { grid-area: 1 / 1; min-width: 0; }\n.cover-layer { display: none; pointer-events: none; }\nbody.cover-on .msg-real.covered > .cover-layer { display: block; }\n\n/* 无交互时只显示伪装；悬停/触屏时两层使用互补的硬边遮罩。\n   不改变真实内容的排版和透明度，圆孔内只有原文，孔外只有伪装。 */\nbody.cover-on .msg-real.covered > .real-wrap { visibility: hidden; }\nbody.cover-on .msg-real.covered:is(.reveal-active, .flash) > .real-wrap {\n  visibility: visible;\n  -webkit-mask-image: radial-gradient(circle var(--hole) at var(--fx) var(--fy), #000 calc(var(--hole) - 1px), transparent var(--hole));\n  mask-image: radial-gradient(circle var(--hole) at var(--fx) var(--fy), #000 calc(var(--hole) - 1px), transparent var(--hole));\n}\nbody.cover-on .msg-real.covered:is(.reveal-active, .flash) > .cover-layer {\n  -webkit-mask-image: radial-gradient(circle var(--hole) at var(--fx) var(--fy), transparent calc(var(--hole) - 1px), #000 var(--hole));\n  mask-image: radial-gradient(circle var(--hole) at var(--fx) var(--fy), transparent calc(var(--hole) - 1px), #000 var(--hole));\n}\n\n/* 光晕 + 镜筒光环：fixed 跟随物理光标，不参与滚动区布局，\n   否则最后一条消息的悬停光晕会撑大 scrollHeight，导致内容跳动 */\nbody.cover-on .msg-real.covered::before {\n  content: ''; position: fixed; left: var(--gx, -9999px); top: var(--gy, -9999px); z-index: 3;\n  width: calc(var(--hole, 140px) * 2.6); height: calc(var(--hole, 140px) * 2.6);\n  transform: translate(-50%, -50%);\n  background: radial-gradient(circle,\n    rgba(140, 235, 190, .13) 0%, rgba(140, 235, 190, .05) 42%, transparent 66%);\n  opacity: 0; transition: opacity .3s ease; pointer-events: none;\n}\nbody.cover-on .msg-real.covered::after {\n  content: ''; position: fixed; left: var(--gx, -9999px); top: var(--gy, -9999px); z-index: 3;\n  width: calc(var(--hole, 140px) * 2); height: calc(var(--hole, 140px) * 2);\n  transform: translate(-50%, -50%); border-radius: 50%;\n  border: 1.5px solid rgba(140, 235, 190, .38);\n  box-shadow: 0 0 26px rgba(140, 235, 190, .20), inset 0 0 34px rgba(140, 235, 190, .10);\n  opacity: 0; transition: opacity .25s ease; pointer-events: none;\n}\nbody.cover-on .msg-real.covered.reveal-active::before,\nbody.cover-on .msg-real.covered.reveal-active::after,\nbody.cover-on .msg-real.covered.flash::before,\nbody.cover-on .msg-real.covered.flash::after {\n  opacity: 1;\n}\nbody.cover-on .msg-real.covered.reveal-active::after,\nbody.cover-on .msg-real.covered.flash::after {\n  animation: torchPulse 2.4s ease-in-out infinite;\n}\n@keyframes torchPulse {\n  0%, 100% { transform: translate(-50%, -50%) scale(1); }\n  50%      { transform: translate(-50%, -50%) scale(1.045); }\n}\n\n/* 覆盖内容配色与真实界面一致（AI 白灰文字 / 自己的灰底白字气泡），伪装观感自然 */\n.cover-ai .cover-tag { font-size: 12.5px; font-weight: 600; color: #8e8e8e; margin: 4px 0 3px; }\n.cover-ai .cover-body {\n  white-space: pre-wrap; word-break: break-word; color: #ececec;\n  font-size: 15.5px; line-height: 1.75;\n}\n.msg-real.has-image > .cover-layer { position: relative; min-height: 300px; }\n.msg-real.has-image .cover-body { overflow: hidden; }\n.cover-image-matte {\n  position: absolute; top: 54px; left: 0;\n  display: flex; align-items: center; justify-content: center;\n  width: min(360px, 100%); height: 270px;\n  border-radius: 12px; background: #2f2f2f; color: #a9a9a9; font-size: 14px;\n}\n@media (prefers-reduced-motion: reduce) {\n  .msg-real::before, .msg-real::after { animation: none !important; transition: none !important; }\n}\n.cursor {\n  display: inline-block; width: 9px; height: 17px; margin-left: 2px; vertical-align: -3px;\n  background: #ececec; border-radius: 1px; animation: blink 1.05s steps(1) infinite;\n}\n@keyframes blink { 50% { opacity: 0; } }\n\n/* “思考中 · Ns” —— 对方输入时显示，形似推理模型的 thinking 指示 */\n.thinking-body { display: flex; align-items: center; gap: 8px; }\n.thinking-text {\n  font-size: 15.5px; font-weight: 600;\n  background: linear-gradient(90deg, #5c5c5c 25%, #d6d6d6 50%, #5c5c5c 75%);\n  background-size: 200% 100%;\n  -webkit-background-clip: text; background-clip: text;\n  -webkit-text-fill-color: transparent; color: transparent;\n  animation: shimmer 1.6s linear infinite;\n}\n.thinking-sec { font-size: 12.5px; color: #8e8e8e; }\n@keyframes shimmer {\n  0% { background-position: 200% 0; }\n  100% { background-position: -200% 0; }\n}\n.thought-line { font-size: 12.5px; color: #9b9b9b; margin-bottom: 6px; }\n.typing-dots { display: inline-flex; gap: 3px; }\n.typing-dots i { width: 5px; height: 5px; border-radius: 50%; background: #7a7a7a; animation: dot 1.2s infinite; }\n.typing-dots i:nth-child(2) { animation-delay: .15s; }\n.typing-dots i:nth-child(3) { animation-delay: .3s; }\n@keyframes dot {\n  0%, 60%, 100% { transform: translateY(0); opacity: .5; }\n  30% { transform: translateY(-3px); opacity: 1; }\n}\n\n/* composer（双行：上输入区，下工具栏） */\n.composer-wrap { flex: none; position: relative; padding: 6px 16px 14px; background: linear-gradient(transparent, #1e1e1e 30%); }\n.composer {\n  display: flex; flex-direction: column; gap: 2px;\n  max-width: 768px; margin: 0 auto;\n  background: #2f2f2f; border: 1px solid rgba(255,255,255,.07);\n  border-radius: 26px;\n  padding: 12px 12px 10px 16px;\n  box-shadow: 0 2px 16px rgba(0,0,0,.25);\n}\n.composer.has-image { padding-top: 16px; }\n#input {\n  width: 100%; border: 0; outline: none; resize: none; background: transparent;\n  max-height: 180px; line-height: 1.6; padding: 2px 4px 8px; color: #ececec;\n}\n#input::placeholder { color: #8e8e8e; }\n.composer-bar { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n.bar-left, .bar-right { display: flex; align-items: center; gap: 6px; min-width: 0; }\n.ghost-btn {\n  width: 32px; height: 32px; border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  color: #b4b4b4; flex: none;\n}\n.ghost-btn:hover { background: rgba(255,255,255,.08); }\n.access-btn {\n  display: flex; align-items: center; gap: 5px;\n  color: #ec8d4e; font-size: 13.5px; font-weight: 600;\n  padding: 6px 10px; border-radius: 12px;\n}\n.access-btn:hover { background: rgba(255,255,255,.08); }\n.access-btn .chev { color: #ec8d4e; font-size: 10px; }\n.ring-btn {\n  width: 30px; height: 30px; border-radius: 50%; flex: none;\n  display: flex; align-items: center; justify-content: center;\n}\n.ring-btn:hover { background: rgba(255,255,255,.08); }\n.ring { width: 15px; height: 15px; border-radius: 50%; border: 2.5px solid #34d399; }\n.model-btn {\n  display: flex; align-items: center; gap: 6px;\n  padding: 6px 10px; border-radius: 12px;\n  max-width: 280px; min-width: 0;\n}\n.model-btn:hover { background: rgba(255,255,255,.08); }\n.model-btn .m-name-label {\n  font-weight: 600; font-size: 14px; color: #ececec;\n  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n}\n.model-btn .m-effort { font-size: 13px; color: #8e8e8e; flex: none; }\n.model-btn .chev { font-size: 10px; color: #8e8e8e; flex: none; }\n#btnSend {\n  width: 34px; height: 34px; border-radius: 50%; flex: none;\n  background: #4f4f4f; color: #fff;\n  display: flex; align-items: center; justify-content: center;\n  transition: background .15s;\n}\n#btnSend:disabled { background: #383838; color: #777; cursor: default; }\n#btnSend:not(:disabled):hover { background: #5f5f5f; }\n.composer-hint { text-align: center; font-size: 12px; color: #7a7a7a; margin-top: 8px; }\n\n/* 下拉菜单（模型 / 完全访问） */\n.model-menu {\n  position: absolute; bottom: calc(100% - 4px); left: 16px;\n  width: 330px; max-width: calc(100vw - 32px);\n  background: #2f2f2f; border: 1px solid #3f3f3f; border-radius: 14px;\n  box-shadow: 0 12px 40px rgba(0,0,0,.45);\n  padding: 6px; z-index: 30; max-height: 330px; overflow-y: auto;\n}\n/* 模型选择器在右下角：无 JS 时也右对齐兜底（打开时由 JS 按按钮实际位置锚定） */\n#modelMenu { left: auto; right: 16px; }\n.model-item { display: block; width: 100%; text-align: left; padding: 9px 12px; border-radius: 10px; }\n.model-item:hover { background: rgba(255,255,255,.06); }\n.model-item .m-name { font-size: 14px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; color: #ececec; }\n.model-item .m-desc { font-size: 12px; color: #8e8e8e; margin-top: 2px; }\n.model-item .m-check { color: #ececec; font-weight: 700; }\n.access-menu { width: 220px; }\n\n/* modal */\n.overlay {\n  position: fixed; inset: 0; z-index: 50;\n  background: rgba(0,0,0,.55);\n  display: flex; align-items: center; justify-content: center;\n}\n.modal {\n  width: 400px; max-width: calc(100vw - 32px);\n  background: #2f2f2f; border: 1px solid rgba(255,255,255,.06);\n  border-radius: 16px; padding: 24px;\n  box-shadow: 0 18px 50px rgba(0,0,0,.45);\n}\n.modal h3 { font-size: 17px; margin-bottom: 4px; color: #ececec; }\n.modal .modal-sub { font-size: 13px; color: #9b9b9b; margin-bottom: 16px; }\n.modal input {\n  width: 100%; background: #262626; border: 1px solid #3f3f3f; border-radius: 10px;\n  padding: 11px 13px; outline: none; margin-bottom: 12px; font-size: 14px; color: #ececec;\n}\n.modal input::placeholder { color: #8e8e8e; }\n.modal input:focus { border-color: #6b6b6b; }\n.modal-actions { display: flex; gap: 10px; margin-top: 6px; }\n.modal-actions button { flex: 1; padding: 11px 0; border-radius: 10px; font-weight: 600; }\n.btn-cancel { background: #3a3a3a; color: #ececec; }\n.btn-cancel:hover { background: #454545; }\n.btn-ok { background: #fff; color: #0d0d0d; }\n.btn-ok:hover { background: #e3e3e3; }\n.link-box {\n  font-family: ui-monospace, Consolas, monospace;\n  font-size: 14px;\n  background: #262626; border: 1px dashed #4a4a4a; border-radius: 12px;\n  text-align: center; padding: 13px 12px; margin: 6px 0 14px;\n  word-break: break-all; user-select: all; color: #ececec;\n}\n\n/* toast */\n#toast {\n  position: fixed; left: 50%; bottom: 110px;\n  transform: translateX(-50%) translateY(20px);\n  background: #2f2f2f; border: 1px solid #454545; color: #ececec;\n  font-size: 14px; border-radius: 10px; padding: 10px 18px;\n  opacity: 0; pointer-events: none; transition: .25s;\n  z-index: 99; max-width: 80vw;\n}\n#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n/* scrollbar */\n::-webkit-scrollbar { width: 8px; }\n::-webkit-scrollbar-thumb { background: rgba(255,255,255,.14); border-radius: 4px; }\n#sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); }\n\n@media (max-width: 768px) {\n  .mobile-only { display: inline-flex; }\n  #sidebar {\n    position: fixed; z-index: 40; top: 0; left: 0; bottom: 0;\n    transform: translateX(-100%); transition: transform .25s;\n    box-shadow: 8px 0 30px rgba(0,0,0,.4);\n  }\n  #sidebar.open { transform: translateX(0); }\n  .side-mask.show { display: block; position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 39; }\n  .msg-col { padding: 20px 14px 10px; }\n}\n
