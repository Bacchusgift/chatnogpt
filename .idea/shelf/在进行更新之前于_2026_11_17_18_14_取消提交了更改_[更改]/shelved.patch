<+><!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>ChatNoGPT</title>\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%230d0d0d'/%3E%3Cpath d='M9 13h14M9 18h9' stroke='white' stroke-width='2.4' stroke-linecap='round'/%3E%3C/svg%3E\">\n<link rel=\"stylesheet\" href=\"/style.css?v=1.3.0\">\n</head>\n<body>\n\n<!-- 登录 / 注册 -->\n<div id=\"authView\" class=\"auth-view hidden\">\n  <div class=\"auth-card\">\n    <div class=\"auth-logo\">ChatNoGPT</div>\n    <div class=\"auth-sub\">你的个人 AI 助手</div>\n    <div class=\"auth-tabs\">\n      <button id=\"tabLogin\" class=\"active\" type=\"button\">登录</button>\n      <button id=\"tabRegister\" type=\"button\">注册</button>\n    </div>\n    <form id=\"loginForm\" autocomplete=\"off\">\n      <input id=\"loginName\" placeholder=\"模型名称\" autocomplete=\"username\" required>\n      <input id=\"loginPassword\" type=\"password\" placeholder=\"密码\" autocomplete=\"current-password\" required>\n      <div class=\"form-error\" id=\"loginError\"></div>\n      <button class=\"btn-primary\" type=\"submit\">继续</button>\n    </form>\n    <form id=\"registerForm\" class=\"hidden\" autocomplete=\"off\">\n      <div class=\"name-row\">\n        <input id=\"regName\" placeholder=\"模型名称，如 gpt-6.1-sol\" maxlength=\"30\" required>\n        <button id=\"btnRerollName\" type=\"button\" title=\"换一个名称\">⟳</button>\n      </div>\n      <input id=\"regPassword\" type=\"password\" placeholder=\"密码（至少 6 位）\" autocomplete=\"new-password\" required>\n      <div class=\"form-error\" id=\"regError\"></div>\n      <button class=\"btn-primary\" type=\"submit\">创建</button>\n    </form>\n  </div>\n</div>\n\n<!-- 主界面 -->\n<div id=\"appView\" class=\"app hidden\">\n  <aside id=\"sidebar\">\n    <div class=\"side-head\">\n      <div class=\"brand\">ChatNoGPT</div>\n      <button id=\"btnNewConv\" class=\"side-new\" type=\"button\">＋ 新增会话</button>\n    </div>\n    <nav id=\"convList\"></nav>\n    <div class=\"side-foot\">\n      <div class=\"user-chip\">\n        <span class=\"avatar\" id=\"meAvatar\">?</span>\n        <span class=\"uname\" id=\"meName\">…</span>\n        <button id=\"btnLogout\" type=\"button\" title=\"退出登录\">退出</button>\n      </div>\n    </div>\n  </aside>\n  <div class=\"side-mask\" id=\"sideMask\"></div>\n\n  <main class=\"chat-main\">\n    <header class=\"chat-head\">\n      <button class=\"icon-btn mobile-only\" id=\"btnToggleSide\" type=\"button\">☰</button>\n      <div class=\"chat-title\" id=\"convTitle\">ChatNoGPT</div>\n      <button id=\"btnRenameConv\" class=\"icon-btn hidden\" type=\"button\" title=\"修改会话标题\">✎</button>\n    </header>\n\n    <div class=\"msg-scroll\" id=\"msgScroll\">\n      <div class=\"msg-col\" id=\"messages\">\n        <div class=\"welcome\" id=\"welcome\">\n          <h1>ChatNoGPT</h1>\n          <p>在下方选择一个模型，发送第一条消息。</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"composer-wrap\">\n      <div class=\"composer\">\n        <div id=\"imagePreview\" class=\"image-preview hidden\"></div>\n        <textarea id=\"input\" rows=\"1\" placeholder=\"询问任何问题\"></textarea>\n        <div class=\"composer-bar\">\n          <div class=\"bar-left\">\n            <button id=\"btnAttach\" class=\"ghost-btn\" type=\"button\" title=\"添加图片\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 5v14M5 12h14\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n            </button>\n            <input id=\"imageInput\" type=\"file\" accept=\"image/*\" class=\"hidden\">\n            <button id=\"btnAccess\" class=\"access-btn\" type=\"button\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>\n              <span id=\"accessLabel\">完全访问</span>\n              <span class=\"chev\">▾</span>\n            </button>\n            <button id=\"btnEffort\" class=\"access-btn\" type=\"button\">\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M9 21h6M10 18h4M12 3a6 6 0 0 0-3.2 11.1c.6.4 1.2 1.1 1.2 1.9h4c0-.8.6-1.5 1.2-1.9A6 6 0 0 0 12 3z\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              <span id=\"effortModeLabel\">思考强度：关闭</span>\n              <span class=\"chev\">▾</span>\n            </button>\n          </div>\n          <div class=\"bar-right\">\n            <button class=\"ring-btn\" type=\"button\" title=\"语音输入\"><span class=\"ring\"></span></button>\n            <button id=\"modelBtn\" class=\"model-btn\" type=\"button\" title=\"选择模型\">\n              <span class=\"m-name-label\" id=\"modelLabel\">选择模型</span>\n              <span class=\"m-effort\" id=\"effortLabel\" style=\"display:none\">最高</span>\n              <span class=\"chev\">▾</span>\n            </button>\n            <button id=\"btnSend\" type=\"button\" title=\"发送\" disabled>\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 19V5M5 12l7-7 7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n            </button>\n          </div>\n        </div>\n      </div>\n      <div class=\"composer-hint\">ChatNoGPT 也可能会犯错，请核查重要信息。</div>\n      <div id=\"modelMenu\" class=\"model-menu hidden\"></div>\n      <div id=\"accessMenu\" class=\"model-menu access-menu hidden\"></div>\n      <div id=\"effortMenu\" class=\"model-menu access-menu hidden\"></div>\n    </div>\n  </main>\n</div>\n\n<div id=\"modalRoot\"></div>\n<div id=\"toast\"></div>\n<script src=\"/app.js?v=1.3.0\"></script>\n<script src=\"/novel.js?v=1.3.0\"></script>\n</body>\n</html>\n
